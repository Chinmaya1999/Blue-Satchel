# Blue Satchel — production server environment.
# Copied to /opt/blue-satchel/server.env by setup-ec2.sh on first run only
# (never overwritten afterwards). Edit the real file on the server directly
# — it never passes through git or CI/CD, by design.

PORT=5000
MONGO_URI=mongodb+srv://CHANGE_ME
JWT_SECRET=CHANGE_ME_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://3.109.152.217

AI_PROVIDER=mock
CRM_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Required when AI_PROVIDER=perfectcorp (YouCam Enterprise AI Skin Analysis).
PERFECTCORP_API_KEY=CHANGE_ME
PERFECTCORP_API_SECRET=CHANGE_ME

# Google sign-in (optional — the "Continue with Google" button stays hidden
# until this is set). Create an OAuth 2.0 Client ID of type "Web application"
# at https://console.cloud.google.com/apis/credentials and add your site
# origins (e.g. https://bluesatchel.online, http://localhost:5173) under
# "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
