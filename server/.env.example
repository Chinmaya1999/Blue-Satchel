PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/bluesatchel
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# --- Enterprise integration placeholders (Section 5.3 / 6 of proposal) ---
# When real vendor accounts are provisioned, swap the Mock* adapters in
# src/services for real implementations of the same interface.
AI_PROVIDER=mock

# Required when AI_PROVIDER=perfectcorp (Perfect Corp / YouCam Enterprise
# AI Skin Analysis, https://yce.makeupar.com). Get these from the API
# console; PERFECTCORP_API_SECRET is the RSA public key (base64, no
# PEM header/footer needed).
PERFECTCORP_API_KEY=
PERFECTCORP_API_SECRET=

# Rupam.ai AI Skin Analysis — https://rupam.ai/en/docs
# RUPAM_API_KEY is the sk_live_… secret key (sent as a Bearer token to
# /auth/token, which returns a short-lived access token for /analyze).
# Quick Scan is wired to Rupam via QUICK_SCAN_PROVIDER; set it to another
# provider name to change that. RUPAM_COLLECT_IMAGE=true lets Rupam store the
# image for overlay assets (default false). RUPAM_API_BASE overrides the host.
RUPAM_API_KEY=
QUICK_SCAN_PROVIDER=rupam
RUPAM_COLLECT_IMAGE=false

# Google sign-in (optional — the "Continue with Google" button stays hidden
# until this is set). Create an OAuth 2.0 Client ID of type "Web application"
# at https://console.cloud.google.com/apis/credentials and add your site
# origins (e.g. https://bluesatchel.online, http://localhost:5173) under
# "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Razorpay — credit purchases (https://dashboard.razorpay.com/app/keys).
# Use rzp_test_… keys for testing, rzp_live_… for real payments. The secret
# must stay server-side. Plans are priced in USD; with RAZORPAY_CURRENCY=INR
# they're charged at USD_INR_RATE rupees per dollar, which unlocks UPI, UPI
# QR, netbanking and wallets (USD orders are card-only and need international
# payments enabled on the account).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR
USD_INR_RATE=96.07

# Outgoing email (welcome + 6-digit verification codes). For Google Workspace:
# smtp.gmail.com:465 with a Google app password (myaccount.google.com →
# Security → App passwords) — not the account's normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Blue Satchel <you@yourdomain.com>"
